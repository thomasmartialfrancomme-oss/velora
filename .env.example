# ─────────────────────────────────────────────────────────────
# VELORA PRIVATE — environment template
# Copy to `.env.local` and fill in real values. Never commit secrets.
# Nothing here is required to run the local demo build.
# ─────────────────────────────────────────────────────────────

# --- Core / security ---------------------------------------------------
# Secret used to sign session tokens. REQUIRED in production: with
# NODE_ENV=production and no AUTH_SECRET of 32+ characters the process fails at
# startup (src/instrumentation.ts) instead of minting a throwaway secret that
# would silently invalidate every session on the next restart.
# Generate:  openssl rand -base64 48
AUTH_SECRET=

# Absolute path of the SQLite database file. Defaults to ./data/velora.db
VELORA_DB_PATH=

# `npm run db:prepare` (and Render's preDeployCommand) applies db/schema.sql and
# creates data/uploads/. Set to 1 to additionally seed the demonstration
# households — their passphrases are published in README.md, so a host reachable
# from the internet should leave this at 0 and register real principals.
VELORA_SEED_DEMO=0

# Set to 1 to keep X-Frame-Options / CSP frame-ancestors off a production
# response, for an internal dashboard that must embed the app inside an iframe.
# Leave it unset on any public origin. Development builds skip those headers
# automatically.
VELORA_ALLOW_FRAMING=

# Public origin used for emails / callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Authentication ----------------------------------------------------
AUTH_TOKEN_TTL_DAYS=7
# bcrypt cost factor
BCRYPT_ROUNDS=12

# --- Database (production target) --------------------------------------
# The application ships with a SQLite adapter (zero-dependency demo) and a
# documented PostgreSQL migration path. See README.md § "Database".
DATABASE_URL=postgresql://velora:velora@localhost:5432/velora

# --- AI provider (optional) --------------------------------------------
# Leave unset to run the deterministic in-house "VELORA AI (demo)" provider.
# When AI_PROVIDER_URL + AI_API_KEY are set, the platform calls your model
# gateway for request analysis and falls back to the deterministic provider
# on any error (the platform never stalls because a vendor is unreachable).
AI_PROVIDER=auto
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=12000

# --- Payments (optional) ------------------------------------------------
# No keys are shipped with this repository. Until STRIPE_SECRET_KEY is set,
# /api/membership/* runs in DemoBilling mode: the subscription state is written
# to our own database and the UI says plainly that nothing was charged.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# How a household may pay. card only, until you have switched the rail on in the
# Stripe Dashboard — an option Stripe has not enabled shows as a dead button.
# Available: card, sepa_debit, us_bank_account, bacs_debit, ideal, bancontact,
#            blik, swish, bank_transfer
# bank_transfer and blik/swish cannot be re-charged automatically, so they are
# offered with the annual plan only, as an invoice with a due date.
VELORA_PAYMENT_METHODS=card
VELORA_TRANSFER_DUE_DAYS=14
# Optional: pin the Stripe API version, or leave empty for the account default.
VELORA_STRIPE_API_VERSION=
# One price per plan *per cycle* — a Stripe price carries its own interval.
# Created for you by: node scripts/stripe-setup.mjs
STRIPE_PRICE_PRIVATE_MONTHLY=
STRIPE_PRICE_PRIVATE_ANNUAL=
STRIPE_PRICE_PRIORITY_MONTHLY=
STRIPE_PRICE_PRIORITY_ANNUAL=
STRIPE_PRICE_PRIVATE_OFFICE_MONTHLY=
STRIPE_PRICE_PRIVATE_OFFICE_ANNUAL=

# --- Email (optional) ----------------------------------------------------
# Password reset / magic links. Without SMTP_URL the reset token is returned
# to the console + the demo UI so the flow can be walked end to end.
# No mailer ships in this build: with SMTP_URL unset, reset and invite links
# are logged to the server console (and returned to the UI in development only)
# so the flows can be walked end to end.
SMTP_URL=
MAIL_FROM="VELORA PRIVATE <no-reply@velora.private>"

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
